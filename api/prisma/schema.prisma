generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model InstructionalMedia {
  id   String @id @default(uuid())
  name String @unique
  code String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("medium_of_instructions")
}
