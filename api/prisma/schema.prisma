generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model MediumOfInstruction {
  id   String @id @default(uuid())
  name String @unique
  code String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subjects Subject[]

  @@map("medium_of_instructions")
}

model Subject {
  id                    String   @id @default(uuid())
  name                  String   @unique
  slug                  String   @unique
  abbreviation          String   @unique
  mediumOfInstructionId String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  mediumOfInstruction MediumOfInstruction @relation(fields: [mediumOfInstructionId], references: [id], onDelete: Restrict)

  @@index([mediumOfInstructionId])
  @@map("subjects")
}
