generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN   @map("admin")
  TEACHER @map("teacher")
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique @db.Citext
  phoneNumber  String   @unique @db.Citext
  fullName     String
  passwordHash String
  role         UserRole @default(TEACHER)
  isActive     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model MediumOfInstruction {
  id   String @id @default(uuid())
  name String @unique @db.Citext
  code String @unique @db.Citext

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subjects Subject[]

  @@map("medium_of_instructions")
}

model Subject {
  id                    String   @id @default(uuid())
  name                  String   @unique @db.Citext
  slug                  String   @unique
  abbreviation          String   @unique @db.Citext
  mediumOfInstructionId String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  mediumOfInstruction MediumOfInstruction @relation(fields: [mediumOfInstructionId], references: [id], onDelete: Restrict)

  @@index([mediumOfInstructionId])
  @@map("subjects")
}
